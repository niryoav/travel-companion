BLOB_READ_WRITE_TOKEN=

# Web Push (VAPID). Generate a keypair locally with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and VITE_VAPID_PUBLIC_KEY must be the SAME public key —
# two names because Vite only exposes VITE_-prefixed vars to client code.
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: only needed if you want to restrict who can trigger the
# reminder cron endpoint. When set, Vercel Cron automatically sends it as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
