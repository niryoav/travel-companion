BLOB_READ_WRITE_TOKEN=

# Web Push (VAPID). Generate a keypair locally with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY and VITE_VAPID_PUBLIC_KEY must be the SAME public key —
# two names because Vite only exposes VITE_-prefixed vars to client code.
VAPID_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Required. The reminder scheduler (api/cron/send-reminders.ts) rejects
# every request without a matching `Authorization: Bearer <CRON_SECRET>`
# header. Scheduling now happens via GitHub Actions, not Vercel Cron — set
# the SAME value as the GitHub repository secret REMINDER_CRON_SECRET below.
CRON_SECRET=

# Optional, server-side only, never read from the client or the request.
# Overrides "now" for the reminder scheduler on this deployment — useful for
# manually testing a specific moment (e.g. a preview deployment) without a
# public query parameter. Leave unset in production; unset it again after
# testing on preview. Example: 2026-08-25T09:00:00Z
REMINDER_TEST_NOW=

# --- GitHub repository secrets (not part of this file — set these under ---
# --- Settings > Secrets and variables > Actions in the GitHub repo)      ---
#
# REMINDER_CRON_URL      Production URL of /api/cron/send-reminders, e.g.
#                        https://travel-companion.example.vercel.app/api/cron/send-reminders
# REMINDER_CRON_SECRET   Must be IDENTICAL to Vercel's CRON_SECRET above.
#
# Never commit these to Git. Scheduled GitHub Actions workflows only run
# from the repository's default branch (main) — .github/workflows/
# send-travel-reminders.yml on a feature branch will not fire on its own
# schedule until merged; use workflow_dispatch to test it manually before
# then.
